{
    "FileVersion": 3,
    "Version": 1,
    "VersionName": "1.0",
    "FriendlyName": "Pineco",
    "Description": "Animation event and GAS task extensions for Unreal Gameplay Targeting System.",
    "Category": "Other",
    "CreatedBy": "tarnishablec",
    "CreatedByURL": "https://github.com/tarnishablec",
    "DocsURL": "",
    "MarketplaceURL": "",
    "CanContainContent": true,
    "IsBetaVersion": true,
    "IsExperimentalVersion": false,
    "Installed": false,
    "Modules": [
        {
            "Name": "PinecoDebug",
            "Type": "Runtime",
            "LoadingPhase": "PostEngineInit",
            "TargetConfigurationAllowList": ["Debug", "DebugGame", "Development"]
        },
        {
            "Name": "PinecoAnimation",
            "Type": "Runtime",
            "LoadingPhase": "Default"
        },
        {
            "Name": "PinecoGAS",
            "Type": "Runtime",
            "LoadingPhase": "Default"
        }
    ],
    "Plugins": [
        {
            "Name": "GameplayAbilities",
            "Enabled": true,
            "Optional": false
        },
        {
            "Name": "TargetingSystem",
            "Enabled": true,
            "Optional": false
        }
    ]
}
